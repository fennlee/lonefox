---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import { getCollection } from 'astro:content';
import { isScrap, slugOf, type Post } from '../../lib/posts';

const all = (await getCollection('blog'))
  .filter((p) => !p.data.draft && isScrap(p))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft && isScrap(p));
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const i = all.findIndex((p) => p.id === post.id);
const newer = i > 0 ? all[i - 1] : null;
const older = i < all.length - 1 ? all[i + 1] : null;
const hasPhotos = Array.isArray(post.data.images) && post.data.images.length > 0;
const cover = post.data.cover || (hasPhotos ? post.data.images[0] : '');
---
<BaseLayout title={post.data.title} description={post.data.description} type="article" image={cover || undefined}>
  <PostArticle
    post={post}
    older={older}
    newer={newer}
    backHref="/scraps/"
    backLabel="scraps"
    ledgerHref="/scraps/"
    ledgerSmall="scraps"
    ledgerText="more paper →"
  />
</BaseLayout>

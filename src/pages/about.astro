---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, about, withAccent } from '../../lonefox.config';
const h = withAccent(about.headline, about.accent);
---
<BaseLayout title="About" description={about.lede}>
  <article class="article about">
    <div class="about-split">
      {about.photo.src && (
        <img class="about-photo" src={about.photo.src} alt={about.photo.alt || ''} />
      )}
      <div class="about-left">
        <span class="article-meta">{about.meta}</span>
        <h3 class="about-head">{h.before}<span style="color: var(--ember)">{h.accent}</span>{h.after}</h3>
        <p class="lede">{about.lede}</p>
        {about.ledeSoft && <p class="lede lede-soft">{about.ledeSoft}</p>}
      </div>
    </div>
    <hr class="ledge-divider" />
    <div class="prose">
      {about.skills.length > 0 && (
        <>
          <h2>stacks &amp; tools <span class="dot">·</span></h2>
          <div class="skills">
            {about.skills.map((g) => (
              <div class="skill-group">
                <span class="skill-lab">{g.label}</span>
                <div class="skill-tags">
                  {g.tags.map((t) => <span class="moetag" data-tone={g.tone}>{t}</span>)}
                </div>
              </div>
            ))}
          </div>
        </>
      )}
      <blockquote>{about.quote}</blockquote>
    </div>
    <hr class="ledge-divider" />
    <div class="links">
      {site.github && <a href={site.github}>github</a>}
      {site.email && <a href={`mailto:${site.email}`}>email</a>}
      <a href="/rss.xml">rss</a>
      <a href="/archive/">the study →</a>
    </div>
  </article>
</BaseLayout>

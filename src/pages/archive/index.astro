---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PawTrail from '../../components/PawTrail.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { archive } from '../../../lonefox.config';

const kindOf = (p: CollectionEntry<'blog'>) =>
  p.data.category === 'tech' ? 'tech' : p.data.category === 'travel' ? 'travel' : 'notes';

const all = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const format = (d: Date) => d.toLocaleDateString('en-CA').replaceAll('-', '.');
const hrefOf = (p: CollectionEntry<'blog'>) => `/archive/${p.id.replace(/\.md$/, '')}/`;
---
<BaseLayout title="Archive" description={archive.lede}>
  <div class="study">
    <header class="arch-head">
      <span class="article-meta">{archive.meta}</span>
      <h1 class="arch-headline">{archive.headline}</h1>
      <p class="lede">{archive.lede}</p>
    </header>
    <hr class="ledge-divider" />
    {archive.drawers.map((d) => {
      const posts = all.filter((p) => kindOf(p) === d.key);
      return (
        <section class="reg">
          <h3 class="reg-title">{d.shelf} <span class="dot">·</span><span class="reg-hint">{d.hint}</span><span class="reg-count">{posts.length} filed</span></h3>
          <ul class="reg-list">
            {posts.map((p) => (
              <li>
                <a class="reg-row" href={hrefOf(p)}>
                  <span class="reg-ico">{d.mark}</span>
                  {d.key === 'travel' && p.data.location && <span class="reg-loc">{p.data.location}</span>}
                  <span class="reg-title2">{p.data.title}</span>
                  <time class="reg-date">{format(p.data.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
    <PawTrail count={3} />
    <a class="back-den" href="/">← back to the den</a>
  </div>
</BaseLayout>

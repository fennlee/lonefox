---
const { count = 5 } = Astro.props;
---
<span class="paw-trail" aria-hidden="true">
  {Array.from({ length: count }).map(() => (
    <svg viewBox="0 0 24 24">
      <ellipse cx="12" cy="16.5" rx="5" ry="4" />
      <circle cx="5.5" cy="10" r="2.1" />
      <circle cx="10" cy="6.5" r="2.1" />
      <circle cx="14.5" cy="6.5" r="2.1" />
      <circle cx="18.5" cy="10" r="2.1" />
    </svg>
  ))}
</span>

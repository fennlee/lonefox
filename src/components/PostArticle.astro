---
import { render } from 'astro:content';
import { hrefOf, locOf, type Post } from '../lib/posts';

const { post, older, newer, backHref, backLabel, ledgerHref, ledgerSmall, ledgerText } = Astro.props as {
  post: Post;
  older: Post | null;
  newer: Post | null;
  backHref: string;
  backLabel: string;
  ledgerHref: string;
  ledgerSmall: string;
  ledgerText: string;
};

const { Content } = await render(post);
const cat = post.data.category;
const isPoem = cat === 'poem';
const poemParas = isPoem
  ? (post.body ?? '').trim().split(/\n[ \t]*\n/).map((s) => s.replace(/\s+$/, ''))
  : [];
const format = (d: Date) => d.toLocaleDateString('en-CA').replaceAll('-', '.');
const metacat = cat === 'travel' ? 'travel' : cat === 'poem' ? 'poetry' : cat === 'tech' ? 'technical note' : 'note';
const pageClass = cat === 'poem' ? 'article poem' : cat === 'travel' ? 'article travel' : 'article';
const hasPhotos = Array.isArray(post.data.images) && post.data.images.length > 0;
const cover = post.data.cover || (hasPhotos ? post.data.images[0] : '');
const place = locOf(post);
---
<article class={pageClass}>
  <header>
    <a class="back-archive" href={backHref}><span>←</span> {backLabel}</a>
    <span class="article-meta">{metacat} / {format(post.data.date)}{place ? ` · ${place}` : ''}</span>
    <h1 class="article-title">{post.data.title}</h1>
    {post.data.description && <p class="lede">{post.data.description}</p>}
  </header>
  <hr class="ledge-divider" />
  {cat === 'travel' && hasPhotos && (
    <figure class="travel-photos">
      <img class="trav-cover" src={cover} alt={post.data.title} loading="eager" />
      {post.data.images.slice(1).map((src) => <img class="trav-thumb" src={src} alt="" loading="lazy" />)}
    </figure>
  )}
  {isPoem ? (
    <div class="prose">
      {poemParas.map((para) => <p>{para}</p>)}
    </div>
  ) : (
    <div class="prose"><Content /></div>
  )}
  <div class="post-nav">
    <div class="post-nav-adj">
      {older && <a href={hrefOf(older)}><small>older</small>← {older.data.title}</a>}
      {newer && <a href={hrefOf(newer)}><small>newer</small>{newer.data.title} →</a>}
    </div>
    <a class="post-nav-ledger" href={ledgerHref}><small>{ledgerSmall}</small>{ledgerText}</a>
  </div>
</article>
